# Multi-stage build: install dependencies into a virtualenv in the build stage,
# then copy only the venv into a clean runtime image. Keeps build toolchains
# (if any wheel had to compile) out of the final image.

FROM python:3.12-slim AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install -r requirements.txt


FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.source=https://github.com/notalib/workshop-containerisation
LABEL org.opencontainers.image.description="Python + Jupyter Lab workshop image"

COPY --from=build /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Preload the HuggingFace model weights into the image so the ML notebooks start
# instantly and work offline. The alternative (downloading on first run),
# can often make containerised ML notebooks unreproducible in the wild.
ENV HF_HOME=/opt/hf-cache
RUN python -c "from transformers import pipeline; pipeline('sentiment-analysis', model='distilbert-base-uncased-finetuned-sst-2-english')" \
 && python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

WORKDIR /app

COPY notebooks/*.ipynb ./
COPY data/sales.csv /data/sales.csv

EXPOSE 8888

# - ip=0.0.0.0 so the host can reach it through the published port
# - no-browser because there's no browser in the container
# - allow-root because we're running as root inside the container
# - fixed token so users don't have to grep the logs for it
ENTRYPOINT ["jupyter", "lab", \
            "--ip=0.0.0.0", \
            "--port=8888", \
            "--allow-root", \
            "--no-browser", \
            "--IdentityProvider.token=workshop"]
