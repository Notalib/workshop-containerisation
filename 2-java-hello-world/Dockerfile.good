# Build stage
# --platform=$BUILDPLATFORM: compile on the host arch (no QEMU). Java bytecode is
# architecture-independent; the per-arch JRE base in the runtime stage does the rest.
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk AS build

WORKDIR /src

COPY Hello.java .

RUN javac Hello.java

# Runtime stage
FROM eclipse-temurin:21-jre

LABEL org.opencontainers.image.source=https://github.com/notalib/workshop-containerisation
LABEL org.opencontainers.image.description="Java hello-world example app"

WORKDIR /app

COPY --from=build /src/Hello.class .
COPY message.txt /data/message.txt

ENV NAME=World

# For containerized Java apps it's a good idea to limit heap to 75% of resource limit.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"

ENTRYPOINT ["java", "Hello"]
